# Convex
CONVEX_DEPLOYMENT=dev:your-convex-deployment
CONVEX_DEPLOYMENT_URL=https://your-convex-deployment.convex.cloud

# Apple Sign In
APPLE_SIGN_IN_CLIENT_IDS=com.example.voiceagent
APPLE_SIGN_IN_CLIENT_SECRET=replace-with-generated-apple-client-secret

# Voice transcription
GROQ_API_KEY=replace-with-groq-api-key

# Error reporting
SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=replace-with-sentry-auth-token
SENTRY_ORG_SLUG=example-org
SENTRY_PROJECT_SLUG=voice-agent

# Product analytics for iOS event capture
POSTHOG_API_KEY=replace-with-posthog-project-api-key
POSTHOG_HOST=https://app.posthog.com

# Product analytics account-cleanup request
POSTHOG_PROJECT_ID=00000
POSTHOG_PERSONAL_API_KEY=replace-with-posthog-personal-api-key

# Install attribution (Apple AdServices). Optional; leave unset to disable.
# The iOS reporter posts to POST /v1/apple-ads-attribution with the shared secret.
APPLE_ADS_ATTRIBUTION_SHARED_SECRET=replace-with-a-random-shared-secret
# Optional: pin the accepted bundle id; leave unset to accept any.
APPLE_ADS_ATTRIBUTION_BUNDLE_ID=com.example.voiceagent.template

# Subscriptions (optional; only if the app monetizes). Backend owns entitlement.
SUBSCRIPTION_PRO_PRODUCT_ID=com.example.voiceagent.template.pro.monthly
# Optional per-tier daily limits (defaults apply if unset):
# FREE_COMMAND_DAILY_LIMIT=250
# PRO_COMMAND_DAILY_LIMIT=2500
